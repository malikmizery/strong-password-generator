<?xml version="1.0" encoding="utf-8"?>
<!-- One self-contained, trimmed spg.exe that runs without .NET installed.
     `dotnet publish` uses this profile automatically (see Spg.csproj); Visual Studio's Publish dialog lists it;
     for `msbuild -t:Publish` pass -p:PublishProfile=SingleFile. Override the target with -r (e.g. -r linux-x64). -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishDir>..\..\out\</PublishDir>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
</Project>
