<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>spg</AssemblyName>
    <RootNamespace>Spg</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Set for every build, not just publish, so build and test also run the trim and single-file analyzers. -->
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
  </PropertyGroup>

  <!-- The rest of the publish settings live in Properties/PublishProfiles/SingleFile.pubxml, which Visual Studio
       also uses. `dotnet publish` picks it by default; `msbuild -t:Publish` needs -p:PublishProfile=SingleFile. -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true' and '$(PublishProfile)' == ''">
    <PublishProfile>SingleFile</PublishProfile>
  </PropertyGroup>

  <ItemGroup>
    <!-- EFF Large Wordlist (7776 words), CC BY 3.0 US: https://www.eff.org/dice -->
    <EmbeddedResource Include="eff_large_wordlist.txt" LogicalName="Spg.eff_large_wordlist.txt" />
    <!-- The Agent Skill that `spg` prints (skill) and installs (install-skill). -->
    <EmbeddedResource Include="SKILL.md" LogicalName="Spg.SKILL.md" />
  </ItemGroup>

</Project>
